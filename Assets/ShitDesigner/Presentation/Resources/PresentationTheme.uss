:root {
    /* GUI/VisualAndInteraction.md canonical dark-theme tokens. */
    --sd-app-background: #0D0F12;
    --sd-panel-background: #15181D;
    --sd-elevated-surface: #1D2229;
    --sd-border: #303741;
    --sd-primary-text: #E8ECF2;
    --sd-secondary-text: #9DA7B4;
    --sd-disabled-text: #626B76;
    --sd-accent: #58A6FF;
    --sd-success: #4CC38A;
    --sd-info: #49BFD1;
    --sd-clamp: #E8B44C;
    --sd-blocked: #E8873A;
    --sd-error: #ED5F68;
    --sd-holding: #C879E8;
    --sd-bg: var(--sd-app-background);
    --sd-panel: var(--sd-panel-background);
    --sd-panel-alt: var(--sd-elevated-surface);
    --sd-text: var(--sd-primary-text);
    --sd-muted: var(--sd-secondary-text);
    --sd-danger: var(--sd-error);
}
.sd-root { background-color: var(--sd-app-background); color: var(--sd-primary-text); min-width: 1280px; min-height: 720px; flex-direction: column; -unity-font-definition: resource("NotoSans"); }
.sd-mono { -unity-font-definition: resource("NotoSansMono"); }
.sd-root.sd-ui-scale-100 { --sd-ui-scale-factor: 1; }
.sd-root.sd-ui-scale-125 { --sd-ui-scale-factor: 1.25; }
.sd-root.sd-ui-scale-150 { --sd-ui-scale-factor: 1.5; }
.sd-dialog { background-color: var(--sd-panel-alt); border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #7882a0; border-right-color: #7882a0; border-top-color: #7882a0; border-bottom-color: #7882a0; padding-left: 20px; padding-right: 20px; padding-top: 16px; padding-bottom: 16px; align-self: center; }
.sd-top-bar { height: 40px; flex-direction: row; align-items: center; flex-shrink: 0; padding-left: 4px; padding-right: 4px; background-color: var(--sd-panel-alt); }
.sd-project-name { min-width: 120px; max-width: 160px; flex-shrink: 1; -unity-font-style: bold; }
.sd-project-actions { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 4px; }
.sd-top-bar Button { min-height: 28px; margin-left: 2px; padding-left: 3px; padding-right: 3px; font-size: 11px; }
.sd-top-layout-selector, .sd-top-program-display-selector { width: 90px; min-width: 80px; min-height: 28px; }
.sd-project-menu-actions { flex-direction: column; }
.sd-project-menu-actions > * { margin-top: 2px; }
.sd-banner { display: none; color: var(--sd-danger); padding-left: 12px; }
.sd-banner.is-visible { display: flex; }
.sd-dock-workspace { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
.sd-dock-tree { flex-direction: column; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; padding: 4px; }
.sd-dock-row { flex-direction: row; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
.sd-graph-toolbar { flex-direction: row; flex-shrink: 0; }
.sd-dock-controls { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.sd-shell-actions { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 4px; }
.sd-panel { background-color: var(--sd-panel); border-left-width: 1px; border-left-color: #3a424f; border-bottom-width: 1px; border-bottom-color: #3a424f; padding: 4px; min-width: 240px; min-height: 160px; }
.sd-panel-header { color: var(--sd-muted); -unity-font-style: bold; margin-bottom: 4px; }
.sd-graph-canvas { background-color: #111318; flex-grow: 1; min-height: 180px; }
.sd-node { background-color: var(--sd-panel-alt); color: var(--sd-text); position: absolute; padding: 4px; border-width: 1px; border-color: var(--sd-accent); }
.sd-node-header { -unity-font-style: bold; color: var(--sd-text); }
.sd-node-status { color: var(--sd-muted); font-size: 10px; }
.sd-node-inline-parameter { color: var(--sd-text); font-size: 11px; }
.sd-node-pending { color: var(--sd-accent); border-bottom-width: 1px; border-bottom-color: var(--sd-accent); border-bottom-style: dashed; }
.sd-node.is-collapsed { min-height: 24px; max-height: 42px; }
.sd-node.status-faulted, .sd-node.status-unknownnode { border-color: var(--sd-danger); }
.sd-port, .sd-connection { color: var(--sd-muted); font-size: 10px; }
.sd-port.is-required { border-left-width: 2px; border-left-color: var(--sd-accent); }
.sd-port.is-optional { border-left-width: 1px; border-left-color: #667080; }
.sd-port.is-drag-source { background-color: #304e62; }
.sd-graph-connection-count { color: var(--sd-muted); font-size: 10px; position: absolute; right: 4px; top: 4px; }
.sd-graph-connection-count.is-at-capacity { color: var(--sd-danger); -unity-font-style: bold; }
.sd-fanout-bundle { color: var(--sd-accent); font-size: 10px; }
.sd-node-search-popup { position: absolute; left: 80px; top: 48px; width: 360px; max-height: 420px; background-color: var(--sd-panel-alt); border-width: 1px; border-color: var(--sd-accent); padding: 6px; z-index: 100; }
.sd-node-search-popup Button { margin-top: 2px; }
.sd-command-palette { position: absolute; left: 30%; top: 12%; width: 420px; max-height: 480px; background-color: var(--sd-panel-alt); border-width: 1px; border-color: var(--sd-accent); padding: 8px; z-index: 200; }
.sd-command-palette Button { margin-top: 3px; }
.sd-connection-dashed { border-bottom-width: 1px; border-bottom-color: var(--sd-accent); border-bottom-style: dashed; }
.sd-focus-target:focus, .sd-focus-target.is-focused { border-left-width: 2px; border-left-color: var(--sd-accent); }
.sd-preview-tab { padding: 3px; flex-grow: 1; min-width: 120px; min-height: 80px; flex-direction: column; background-color: #090a0c; }
.sd-preview-tab-toolbar { flex-direction: row; flex-wrap: wrap; }
.sd-preview-tab-toolbar Button { margin-right: 2px; }
.sd-preview-quality-popover { background-color: var(--sd-panel-alt); border-width: 1px; border-color: var(--sd-accent); padding: 4px; }
.sd-preview-tab > .is-bound, .sd-preview-tab > .is-unavailable { min-width: 64px; min-height: 36px; flex-grow: 1; }
.sd-preview-tab.is-fit > .is-bound { -unity-background-scale-mode: scale-to-fit; }
.sd-preview-tab.is-fill > .is-bound { -unity-background-scale-mode: scale-and-crop; }
.sd-preview-tab.is-stretch > .is-bound { -unity-background-scale-mode: stretch-to-fill; }
.sd-preview-tab.is-black, .sd-preview-tab.is-black > .is-unavailable { background-color: #000000; }
.sd-preview-tab.is-checker, .sd-preview-tab.is-checker > .is-unavailable { background-color: #565b65; }
.sd-preview-tab > .is-unavailable { color: var(--sd-muted); background-color: #000000; }
.reduce-motion, .reduce-motion * { transition-duration: 0ms; transition-delay: 0ms; }
.sd-output-surface { background-color: #090a0c; margin: 2px; flex-grow: 1; }
.sd-display-identify-overlay { position: absolute; left: 0; right: 0; top: 40px; min-height: 32px; flex-direction: row; justify-content: center; background-color: rgba(32, 36, 44, .92); color: var(--sd-text); z-index: 10; }
.sd-status-bar { height: 24px; flex-direction: row; align-items: center; flex-shrink: 0; background-color: var(--sd-panel-alt); color: var(--sd-muted); padding-left: 8px; border-top-width: 1px; border-top-color: var(--sd-border); }
.sd-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.sd-layer, .sd-banner { picking-mode: ignore; }
.sd-dashboard-widget { background-color: #333b49; color: var(--sd-text); padding: 2px; }
.sd-media-item, .sd-preset-item, .sd-library-item { margin-top: 2px; }
.is-closed, .is-hidden { display: none; }
.sd-elevated { background-color: var(--sd-elevated-surface); border-color: var(--sd-border); border-width: 1px; }
.sd-secondary { color: var(--sd-secondary-text); }
.sd-disabled { color: var(--sd-disabled-text); }
.sd-status-blocked { color: var(--sd-blocked); border-color: var(--sd-blocked); }
.sd-status-faulted { color: var(--sd-error); border-color: var(--sd-error); }
.sd-status-preparing { color: var(--sd-info); border-color: var(--sd-info); }
.sd-status-fallback { color: var(--sd-clamp); border-color: var(--sd-clamp); }
.sd-status-holding { color: var(--sd-holding); border-color: var(--sd-holding); }
.sd-connection-dashed { border-bottom-width: 2px; border-bottom-color: var(--sd-info); border-bottom-style: dashed; }
.reduce-motion * { transition-duration: 0ms; transition-delay: 0ms; }
