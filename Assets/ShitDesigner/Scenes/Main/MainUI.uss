.main-ui {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
}

.workspace {
    flex-grow: 1;
    flex-direction: row;
    padding: 8px;
}

.program-monitor {
    flex-grow: 1;
    background-color: black;
    -unity-background-scale-mode: scale-to-fit;
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.control-panel {
    width: 320px;
    margin-left: 8px;
    padding: 12px;
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.panel-title {
    margin-bottom: 8px;
    color: rgb(232, 236, 242);
    font-size: 15px;
    -unity-font-style: bold;
}

.parameter-controls {
    margin-top: 8px;
    margin-bottom: 8px;
}

.output-actions {
    flex-direction: row;
    margin-top: 8px;
}

.output-actions > Button {
    flex-grow: 1;
    height: 30px;
    margin-right: 4px;
    color: rgb(232, 236, 242);
    background-color: rgb(29, 34, 41);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.output-actions > Button:hover {
    background-color: rgb(36, 43, 52);
    border-color: rgb(88, 166, 255);
}

.status-label,
.diagnostic-label {
    margin-top: 12px;
    white-space: normal;
    font-size: 10px;
}

.diagnostic-label {
    color: rgb(255, 113, 130);
}

.confirmation-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 15, 18, 0.92);
}

.confirmation-overlay.is-hidden,
.confirmation-button.is-hidden {
    display: none;
}

.confirmation-dialog {
    width: 380px;
    padding: 12px 16px 14px 16px;
    background-color: rgb(29, 34, 41);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.confirmation-title {
    color: rgb(232, 236, 242);
    font-size: 15px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}

.confirmation-rule {
    height: 1px;
    margin-top: 7px;
    background-color: rgb(48, 55, 65);
}

.confirmation-message {
    margin-top: 7px;
    max-width: 348px;
    color: rgb(157, 167, 180);
    font-size: 10px;
    letter-spacing: 0.2px;
    white-space: normal;
}

.display-selector {
    height: 30px;
    min-height: 30px;
    margin-top: 10px;
    align-items: center;
    color: rgb(157, 167, 180);
    font-size: 11px;
    white-space: normal;
}

.display-selector .unity-base-field__label {
    min-width: 104px;
    color: rgb(157, 167, 180);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.display-selector .unity-base-popup-field__input {
    height: 30px;
    min-height: 30px;
    padding-left: 10px;
    padding-right: 8px;
    align-items: center;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    border-radius: 0;
}

.display-selector .unity-base-popup-field__text {
    height: 22px;
    color: rgb(232, 236, 242);
    font-size: 11px;
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.confirmation-actions {
    margin-top: 12px;
    flex-direction: row;
    justify-content: flex-end;
}

.confirmation-button {
    height: 28px;
    min-width: 78px;
    margin-left: 8px;
    color: rgb(232, 236, 242);
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 9px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
}

.confirmation-button:hover {
    color: rgb(232, 236, 242);
    background-color: rgb(36, 43, 52);
    border-color: rgb(88, 166, 255);
}

.confirmation-accept {
    color: rgb(255, 255, 255);
    background-color: rgb(47, 111, 179);
    border-color: rgb(88, 166, 255);
}

.confirmation-accept.is-stop {
    color: rgb(255, 255, 255);
    background-color: rgb(164, 53, 64);
    border-color: rgb(237, 95, 104);
}
