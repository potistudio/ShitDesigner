.main-ui {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
}

.top-bar {
    width: auto;
    min-width: 0;
    height: 40px;
    min-height: 40px;
    flex-shrink: 0;
    align-self: stretch;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(21, 24, 29);
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 55, 65);
}

.workspace {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
}

.inspector-column {
    width: 320px;
    min-width: 320px;
    flex-shrink: 0;
    flex-direction: column;
}

.preview-stack {
    flex-grow: 1;
    min-width: 0;
}

.output-previews {
    width: 1280px;
    height: 440px;
    min-width: 1280px;
    min-height: 440px;
    flex-direction: row;
    align-items: flex-start;
    flex-shrink: 0;
}

.output-2-column {
    width: 640px;
    min-width: 640px;
    max-width: 640px;
    height: 440px;
    min-height: 440px;
    flex-direction: column;
    flex-grow: 0;
    flex-shrink: 0;
}

.output-preview {
    position: relative;
    width: 640px;
    height: 360px;
    min-width: 640px;
    min-height: 360px;
    max-width: 640px;
    max-height: 360px;
    flex-grow: 0;
    flex-shrink: 0;
    background-color: black;
    -unity-background-scale-mode: stretch-to-fill;
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.output-preview-label {
    position: absolute;
    left: 8px;
    top: 8px;
    color: rgb(232, 236, 242);
    background-color: rgba(13, 15, 18, 0.8);
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: 11px;
    -unity-font-style: bold;
}

.control-panel {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: 8px;
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.sequencer-controls {
    width: 1280px;
    min-width: 1280px;
    max-width: 1280px;
    height: 132px;
    min-height: 132px;
    max-height: 132px;
    flex-direction: row;
    flex-shrink: 0;
    background-color: rgb(13, 15, 18);
}

.sequencer {
    width: 640px;
    min-width: 640px;
    max-width: 640px;
    flex-grow: 0;
    flex-shrink: 0;
}

.sequencer-title {
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    padding-left: 6px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    color: rgb(232, 236, 242);
    background-color: rgb(29, 34, 41);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.sequencer-beat-header,
.sequencer-lane {
    width: 640px;
    min-width: 640px;
    max-width: 640px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
}

.sequencer-lane-label,
.sequencer-corner {
    width: 64px;
    min-width: 64px;
    max-width: 64px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: rgb(117, 128, 142);
    background-color: rgb(21, 24, 29);
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(48, 55, 65);
    border-radius: 0;
    font-size: 8px;
    -unity-text-align: middle-center;
}

.sequencer-lane-label.is-clickable:hover {
    color: rgb(232, 236, 242);
    background-color: rgb(36, 43, 52);
}

.sequencer-lane-label.is-assigned {
    color: rgb(180, 215, 255);
    background-color: rgb(29, 62, 96);
}

.sequencer-lane-label.is-selecting {
    color: rgb(13, 15, 18);
    background-color: rgb(255, 190, 74);
}

.sequencer-beat-label,
.sequencer-step {
    width: 72px;
    min-width: 72px;
    max-width: 72px;
    flex-grow: 0;
    flex-shrink: 0;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    margin: 0;
    padding: 0;
    border-left-width: 0;
    border-top-width: 0;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(48, 55, 65);
    border-radius: 0;
    -unity-text-align: middle-center;
}

.sequencer-beat-label {
    color: rgb(117, 128, 142);
    background-color: rgb(21, 24, 29);
    font-size: 8px;
}

.sequencer-step {
    color: rgb(157, 167, 180);
    background-color: rgb(13, 15, 18);
    font-size: 7px;
}

.sequencer-step:hover {
    background-color: rgb(36, 43, 52);
}

.sequencer-step.is-set {
    background-color: rgb(47, 111, 179);
}

.sequencer-step.is-playhead {
    border-bottom-color: rgb(255, 190, 74);
}

.sequencer-step.is-set.is-playhead {
    background-color: rgb(78, 139, 205);
}

.patch-controls {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
}

.patch-scroll-rows {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
}

.patch-row-controls {
    height: 32px;
    min-height: 32px;
    max-height: 32px;
    flex-grow: 0;
    min-width: 0;
}

.patch-row-controls .unity-scroll-view__content-container {
    flex-direction: row;
    padding-left: 50%;
    padding-right: 50%;
}

.patch-role-labels {
    width: 56px;
    min-width: 56px;
    max-width: 56px;
    flex-shrink: 0;
}

.patch-role-label {
    height: 32px;
    min-height: 32px;
    flex-shrink: 0;
    margin: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    color: rgb(157, 167, 180);
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 9px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.patch-dock {
    height: 64px;
    min-height: 64px;
    max-height: 64px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 0;
    background-color: rgb(21, 24, 29);
    border-top-width: 1px;
    border-top-color: rgb(48, 55, 65);
}

.patch-slot-controls {
    width: 640px;
    min-width: 640px;
    max-width: 640px;
    height: 80px;
    min-height: 80px;
    max-height: 80px;
    flex-direction: row;
    align-items: flex-start;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    background-color: rgb(13, 15, 18);
    border-top-width: 0;
    border-bottom-width: 0;
    border-color: rgb(48, 55, 65);
}

.patch-slot-button {
    width: 80px;
    min-width: 80px;
    max-width: 80px;
    height: 80px;
    min-height: 80px;
    max-height: 80px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    color: rgb(157, 167, 180);
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-background-scale-mode: scale-and-crop;
}

.patch-slot-button.is-selected {
    border-color: rgb(88, 166, 255);
}

.patch-slot-button.is-cued {
    color: rgb(180, 215, 255);
}

.patch-slot-button.is-playing {
    color: rgb(255, 255, 255);
    background-color: rgb(47, 111, 179);
}

.patch-slot-button:hover {
    background-color: rgb(36, 43, 52);
    border-color: rgb(88, 166, 255);
}

.patch-button {
    height: 32px;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 10px;
}

.patch-button {
    flex-grow: 0;
    flex-shrink: 0;
    min-width: 160px;
}

.patch-button.is-preloaded {
    border-color: rgb(88, 166, 255);
}

.patch-button.is-selected {
    border-color: rgb(88, 166, 255);
}

.patch-button.is-assignment-option {
    border-color: rgb(255, 190, 74);
}

.patch-row-controls.is-scene-selecting {
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(255, 190, 74);
}

.patch-button.is-queued {
    color: rgb(180, 215, 255);
}

.patch-button.is-loaded {
    color: rgb(255, 255, 255);
    background-color: rgb(47, 111, 179);
}

.tempo-controls {
    margin-top: 4px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: rgb(48, 55, 65);
}

.tempo-input-row {
    flex-direction: row;
    height: 32px;
}

.tempo-alignment-button {
    flex-grow: 1;
    height: 32px;
    margin-top: 4px;
    color: rgb(232, 236, 242);
    background-color: rgb(29, 34, 41);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 10px;
    -unity-font-style: bold;
}

.tempo-bpm-input {
    flex-grow: 1;
    min-width: 0;
}

.tempo-bpm-input .unity-base-text-field__input {
    height: 30px;
    min-height: 30px;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    border-radius: 0;
}

.tempo-tap-button {
    width: 72px;
    margin-left: 4px;
    color: rgb(232, 236, 242);
    background-color: rgb(29, 34, 41);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 10px;
    -unity-font-style: bold;
}

.tempo-tap-button:hover {
    background-color: rgb(36, 43, 52);
    border-color: rgb(88, 166, 255);
}

.tempo-alignment-button:hover {
    background-color: rgb(36, 43, 52);
    border-color: rgb(88, 166, 255);
}

.parameter-controls {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
    justify-content: space-around;
    padding: 8px;
}

.live-fader-panel {
    height: 264px;
    min-height: 264px;
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.parameter-fader-channel {
    flex-grow: 1;
    min-width: 88px;
    max-width: 160px;
    align-items: center;
}

.parameter-fader-value {
    height: 28px;
    min-width: 56px;
    -unity-text-align: middle-center;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 10px;
}

.parameter-slider {
    flex-grow: 1;
    min-height: 100px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.parameter-slider .unity-base-slider__tracker {
    width: 4px;
    background-color: rgb(48, 55, 65);
    border-width: 0;
}

.parameter-slider .unity-base-slider__dragger {
    width: 28px;
    height: 12px;
    margin-left: -11px;
    background-color: rgb(88, 166, 255);
    border-width: 1px;
    border-color: rgb(180, 215, 255);
}

.parameter-fader-label {
    color: rgb(157, 167, 180);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.output-actions {
    flex-direction: row;
    margin-top: 4px;
}

.top-bar .output-actions {
    width: 216px;
    flex-shrink: 0;
    margin-top: 0;
}

.output-action {
    flex-grow: 1;
    height: 32px;
    color: rgb(232, 236, 242);
    background-color: rgb(29, 34, 41);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.top-bar .output-action {
    flex-grow: 0;
    width: 104px;
    height: 28px;
    font-size: 10px;
}

.output-action-secondary {
    margin-left: 4px;
}

.output-action:hover {
    background-color: rgb(36, 43, 52);
    border-color: rgb(88, 166, 255);
}

.status-label,
.diagnostic-label {
    margin-top: 4px;
    white-space: normal;
    font-size: 10px;
}

.diagnostic-label {
    color: rgb(255, 113, 130);
}

.confirmation-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 15, 18, 0.92);
}

.confirmation-overlay.is-hidden,
.confirmation-button.is-hidden {
    display: none;
}

.confirmation-dialog {
    width: 400px;
    padding: 16px;
    background-color: rgb(29, 34, 41);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.confirmation-title {
    color: rgb(232, 236, 242);
    font-size: 15px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}

.confirmation-rule {
    height: 1px;
    margin-top: 8px;
    background-color: rgb(48, 55, 65);
}

.confirmation-message {
    margin-top: 8px;
    max-width: 368px;
    color: rgb(157, 167, 180);
    font-size: 10px;
    letter-spacing: 0.2px;
    white-space: normal;
}

.display-selector {
    height: 32px;
    min-height: 32px;
    margin-top: 8px;
    align-items: center;
    color: rgb(157, 167, 180);
    font-size: 11px;
    white-space: normal;
}

.display-selector .unity-base-field__label {
    min-width: 104px;
    color: rgb(157, 167, 180);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.display-selector .unity-base-popup-field__input {
    height: 32px;
    min-height: 32px;
    padding-left: 8px;
    padding-right: 8px;
    align-items: center;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    border-radius: 0;
}

.display-selector .unity-base-popup-field__text {
    height: 24px;
    color: rgb(232, 236, 242);
    font-size: 11px;
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.confirmation-actions {
    margin-top: 16px;
    flex-direction: row;
    justify-content: flex-end;
}

.confirmation-button {
    height: 32px;
    min-width: 80px;
    margin-left: 8px;
    color: rgb(232, 236, 242);
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 9px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
}

.confirmation-button:hover {
    color: rgb(232, 236, 242);
    background-color: rgb(36, 43, 52);
    border-color: rgb(88, 166, 255);
}

.confirmation-accept {
    color: rgb(255, 255, 255);
    background-color: rgb(47, 111, 179);
    border-color: rgb(88, 166, 255);
}

.confirmation-accept.is-stop {
    color: rgb(255, 255, 255);
    background-color: rgb(164, 53, 64);
    border-color: rgb(237, 95, 104);
}
