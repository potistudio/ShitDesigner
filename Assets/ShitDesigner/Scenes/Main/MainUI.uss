.main-ui {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
}

.workspace {
    flex-grow: 1;
    flex-direction: row;
}

.preview-stack {
    flex-grow: 1;
    min-width: 0;
}

.program-monitor {
    flex-grow: 1;
    min-height: 0;
    background-color: black;
    -unity-background-scale-mode: scale-to-fit;
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.control-panel {
    width: 320px;
    padding: 8px;
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.patch-controls {
    flex-direction: row;
    flex-wrap: nowrap;
    height: 32px;
}

.patch-controls .unity-scroll-view__content-container {
    flex-direction: row;
    padding-left: 50%;
    padding-right: 50%;
}

.patch-button {
    flex-grow: 1;
    height: 32px;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 10px;
}


.patch-button.is-preloaded {
    border-color: rgb(88, 166, 255);
}

.patch-button.is-loaded {
    color: rgb(255, 255, 255);
    background-color: rgb(47, 111, 179);
}


.parameter-controls {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
    justify-content: space-around;
    padding: 8px;
}

.live-fader-panel {
    height: 264px;
    min-height: 264px;
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.parameter-fader-channel {
    flex-grow: 1;
    min-width: 88px;
    max-width: 160px;
    align-items: center;
}

.parameter-fader-value {
    height: 28px;
    min-width: 56px;
    -unity-text-align: middle-center;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 10px;
}

.parameter-slider {
    flex-grow: 1;
    min-height: 100px;
    margin-top: 4px;
    margin-bottom: 4px;
}

.parameter-slider .unity-base-slider__tracker {
    width: 4px;
    background-color: rgb(48, 55, 65);
    border-width: 0;
}

.parameter-slider .unity-base-slider__dragger {
    width: 28px;
    height: 12px;
    margin-left: -11px;
    background-color: rgb(88, 166, 255);
    border-width: 1px;
    border-color: rgb(180, 215, 255);
}

.parameter-fader-label {
    color: rgb(157, 167, 180);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.output-actions {
    flex-direction: row;
    margin-top: 4px;
}

.output-action {
    flex-grow: 1;
    height: 32px;
    color: rgb(232, 236, 242);
    background-color: rgb(29, 34, 41);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.output-action-secondary {
    margin-left: 4px;
}

.output-actions > Button:hover {
    background-color: rgb(36, 43, 52);
    border-color: rgb(88, 166, 255);
}

.status-label,
.diagnostic-label {
    margin-top: 8px;
    white-space: normal;
    font-size: 10px;
}

.diagnostic-label {
    color: rgb(255, 113, 130);
}

.confirmation-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(13, 15, 18, 0.92);
}

.confirmation-overlay.is-hidden,
.confirmation-button.is-hidden {
    display: none;
}

.confirmation-dialog {
    width: 400px;
    padding: 16px;
    background-color: rgb(29, 34, 41);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.confirmation-title {
    color: rgb(232, 236, 242);
    font-size: 15px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}

.confirmation-rule {
    height: 1px;
    margin-top: 8px;
    background-color: rgb(48, 55, 65);
}

.confirmation-message {
    margin-top: 8px;
    max-width: 368px;
    color: rgb(157, 167, 180);
    font-size: 10px;
    letter-spacing: 0.2px;
    white-space: normal;
}

.display-selector {
    height: 32px;
    min-height: 32px;
    margin-top: 8px;
    align-items: center;
    color: rgb(157, 167, 180);
    font-size: 11px;
    white-space: normal;
}

.display-selector .unity-base-field__label {
    min-width: 104px;
    color: rgb(157, 167, 180);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.display-selector .unity-base-popup-field__input {
    height: 32px;
    min-height: 32px;
    padding-left: 8px;
    padding-right: 8px;
    align-items: center;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    border-radius: 0;
}

.display-selector .unity-base-popup-field__text {
    height: 24px;
    color: rgb(232, 236, 242);
    font-size: 11px;
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.confirmation-actions {
    margin-top: 16px;
    flex-direction: row;
    justify-content: flex-end;
}

.confirmation-button {
    height: 32px;
    min-width: 80px;
    margin-left: 8px;
    color: rgb(232, 236, 242);
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 9px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
}

.confirmation-button:hover {
    color: rgb(232, 236, 242);
    background-color: rgb(36, 43, 52);
    border-color: rgb(88, 166, 255);
}

.confirmation-accept {
    color: rgb(255, 255, 255);
    background-color: rgb(47, 111, 179);
    border-color: rgb(88, 166, 255);
}

.confirmation-accept.is-stop {
    color: rgb(255, 255, 255);
    background-color: rgb(164, 53, 64);
    border-color: rgb(237, 95, 104);
}
