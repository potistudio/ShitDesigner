.main-ui {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(190, 211, 218);
    background-color: rgb(5, 8, 10);
}

.workspace {
    flex-grow: 1;
    flex-direction: row;
    padding: 12px;
}

.program-monitor {
    flex-grow: 1;
    background-color: black;
    -unity-background-scale-mode: scale-to-fit;
    border-width: 1px;
    border-color: rgb(48, 79, 85);
}

.control-panel {
    width: 320px;
    margin-left: 12px;
    padding: 14px;
    background-color: rgb(8, 12, 14);
    border-width: 1px;
    border-color: rgb(67, 112, 121);
}

.panel-title {
    margin-bottom: 12px;
    color: rgb(224, 244, 247);
    font-size: 15px;
    -unity-font-style: bold;
}

.parameter-controls {
    margin-top: 8px;
    margin-bottom: 8px;
}

.output-actions {
    flex-direction: row;
    margin-top: 8px;
}

.output-actions > Button {
    flex-grow: 1;
    height: 30px;
    margin-right: 4px;
    color: rgb(175, 226, 234);
    background-color: rgba(25, 93, 104, 0.22);
    border-color: rgb(79, 154, 166);
}

.status-label,
.diagnostic-label {
    margin-top: 12px;
    white-space: normal;
    font-size: 10px;
}

.diagnostic-label {
    color: rgb(255, 113, 130);
}

.confirmation-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 4, 5, 0.82);
}

.confirmation-overlay.is-hidden,
.confirmation-button.is-hidden {
    display: none;
}

.confirmation-dialog {
    width: 380px;
    padding: 12px 16px 14px 16px;
    background-color: rgba(8, 12, 14, 0.98);
    border-width: 1px;
    border-color: rgb(67, 112, 121);
}

.confirmation-title {
    color: rgb(224, 244, 247);
    font-size: 15px;
    letter-spacing: 1.2px;
    -unity-font-style: bold;
}

.confirmation-rule {
    height: 1px;
    margin-top: 7px;
    background-color: rgb(48, 79, 85);
}

.confirmation-message {
    margin-top: 7px;
    max-width: 348px;
    color: rgb(116, 148, 154);
    font-size: 10px;
    letter-spacing: 0.2px;
    white-space: normal;
}

.display-selector {
    height: 30px;
    min-height: 30px;
    margin-top: 10px;
    align-items: center;
    color: rgb(166, 195, 201);
    font-size: 11px;
}

.display-selector .unity-base-field__label {
    min-width: 104px;
    color: rgb(85, 127, 135);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.display-selector .unity-base-popup-field__input {
    height: 30px;
    min-height: 30px;
    padding-left: 10px;
    padding-right: 8px;
    align-items: center;
    color: rgb(190, 218, 224);
    background-color: rgb(5, 9, 10);
    border-width: 1px;
    border-color: rgb(53, 91, 98);
}

.display-selector .unity-base-popup-field__text {
    height: 22px;
    color: rgb(220, 239, 242);
    font-size: 11px;
    -unity-text-align: middle-left;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.confirmation-actions {
    margin-top: 12px;
    flex-direction: row;
    justify-content: flex-end;
}

.confirmation-button {
    height: 28px;
    min-width: 78px;
    margin-left: 8px;
    color: rgb(134, 169, 176);
    background-color: transparent;
    border-width: 1px;
    border-color: rgb(52, 84, 91);
    font-size: 9px;
    letter-spacing: 0.5px;
    -unity-font-style: bold;
}

.confirmation-button:hover {
    color: rgb(215, 239, 243);
    background-color: rgba(48, 104, 114, 0.2);
    border-color: rgb(93, 158, 169);
}

.confirmation-accept {
    color: rgb(175, 226, 234);
    background-color: rgba(25, 93, 104, 0.22);
    border-color: rgb(79, 154, 166);
}

.confirmation-accept.is-stop {
    color: rgb(255, 113, 130);
    background-color: rgba(135, 24, 42, 0.22);
    border-color: rgb(198, 55, 75);
}
