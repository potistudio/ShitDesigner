.main-ui {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(190, 211, 218);
    background-color: rgb(5, 8, 10);
}

.workspace {
    flex-grow: 1;
    flex-direction: row;
    padding: 12px;
}

.program-monitor {
    flex-grow: 1;
    background-color: black;
    -unity-background-scale-mode: scale-to-fit;
    border-width: 1px;
    border-color: rgb(48, 79, 85);
}

.control-panel {
    width: 320px;
    margin-left: 12px;
    padding: 14px;
    background-color: rgb(8, 12, 14);
    border-width: 1px;
    border-color: rgb(67, 112, 121);
}

.panel-title {
    margin-bottom: 12px;
    color: rgb(224, 244, 247);
    font-size: 15px;
    -unity-font-style: bold;
}

.parameter-controls {
    margin-top: 8px;
    margin-bottom: 8px;
}

.output-actions {
    flex-direction: row;
    margin-top: 8px;
}

.output-actions > Button {
    flex-grow: 1;
    height: 30px;
    margin-right: 4px;
    color: rgb(175, 226, 234);
    background-color: rgba(25, 93, 104, 0.22);
    border-color: rgb(79, 154, 166);
}

.status-label,
.diagnostic-label {
    margin-top: 12px;
    white-space: normal;
    font-size: 10px;
}

.diagnostic-label {
    color: rgb(255, 113, 130);
}
