                    <ui:Button name="bpm-tap" text="TAP" class="tempo-tap-button"/>
                </ui:VisualElement>
                <ui:Button name="beat-alignment-button" text="ALIGN BEAT" class="tempo-alignment-button"/>
                <ui:Button name="time-easing-button" text="TIME EASE ON" class="tempo-alignment-button tempo-time-easing-button"/>
                <ui:Button name="scene-quantize-button" text="SCENE Q OFF" class="tempo-alignment-button tempo-quantize-mode-button"/>
                <ui:Button name="hot-cue-quantize-button" text="HOT CUE Q OFF" class="tempo-alignment-button tempo-quantize-mode-button"/>
                <ui:Button name="main-cue-quantize-button" text="MAIN CUE Q OFF" class="tempo-alignment-button tempo-quantize-mode-button"/>
                <ui:Button name="piano-fx-quantize-button" text="PIANO FX Q OFF" class="tempo-alignment-button tempo-quantize-mode-button"/>
            </ui:VisualElement>
