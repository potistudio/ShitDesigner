<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/ShitDesigner/Scenes/Main/MainUI.uss?fileID=7433441132597879392&amp;guid=7e3b7d42d5904ebf83a22f50f92ce618&amp;type=3#MainUI"/>
    <ui:VisualElement name="main-ui" class="main-ui">
        <ui:VisualElement class="workspace">
            <ui:VisualElement class="preview-stack">
                <ui:VisualElement class="output-previews">
                    <ui:VisualElement class="output-preview-column">
                        <ui:VisualElement name="program-monitor" class="output-preview output-preview-1">
                            <ui:Label text="Output 1" class="output-preview-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="cue-slots" class="cue-slots">
                            <ui:VisualElement name="cue-slot-1" class="cue-slot">
                                <ui:Label text="Cue Slot 1" class="output-preview-label"/>
                            </ui:VisualElement>
                            <ui:VisualElement name="cue-slot-2" class="cue-slot">
                                <ui:Label text="Cue Slot 2" class="output-preview-label"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="output-2-column">
                        <ui:VisualElement name="output-2-preview" class="output-preview output-preview-2">
                            <ui:VisualElement name="output-2-content" class="output-2-content"/>
                            <ui:Label name="output-2-label" text="Output 2" class="output-preview-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="sequencer-controls" class="sequencer-controls">
                            <ui:VisualElement name="overlay-sequencer" class="sequencer"/>
                            <ui:VisualElement name="effect-sequencer" class="sequencer"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="instant-effect-cues" class="instant-effect-cues">
                    <ui:Button name="instant-effect-cue-1" text="Q" tooltip="Instant Effect Trigger 1" class="instant-effect-cue-button"/>
                    <ui:Button name="instant-effect-cue-2" text="W" tooltip="Instant Effect Trigger 2" class="instant-effect-cue-button"/>
                    <ui:Button name="instant-effect-cue-3" text="E" tooltip="Instant Effect Trigger 3" class="instant-effect-cue-button"/>
                    <ui:Button name="instant-effect-cue-4" text="R" tooltip="Instant Effect Trigger 4" class="instant-effect-cue-button"/>
                    <ui:Button name="instant-effect-cue-5" text="T" tooltip="Instant Effect Trigger 5" class="instant-effect-cue-button"/>
                    <ui:Button name="instant-effect-cue-6" text="Y" tooltip="Instant Effect Trigger 6" class="instant-effect-cue-button"/>
                    <ui:Button name="instant-effect-cue-7" text="U" tooltip="Instant Effect Trigger 7" class="instant-effect-cue-button"/>
                    <ui:Button name="instant-effect-cue-8" text="I" tooltip="Instant Effect Trigger 8" class="instant-effect-cue-button"/>
                    <ui:Button name="instant-effect-cue-9" text="O" tooltip="Instant Effect Trigger 9" class="instant-effect-cue-button"/>
                    <ui:Button name="instant-effect-cue-10" text="P" tooltip="Instant Effect Trigger 10" class="instant-effect-cue-button"/>
                </ui:VisualElement>
                <ui:VisualElement class="live-fader-panel">
                    <ui:VisualElement name="parameter-controls" class="parameter-controls"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="inspector-column">
                <ui:VisualElement name="sidebar-tabs" class="sidebar-tabs">
                    <ui:Button name="main-tab" text="MAIN" class="sidebar-tab is-selected"/>
                    <ui:Button name="overlay-tab" text="OVERLAY" class="sidebar-tab"/>
                    <ui:Button name="effect-tab" text="FX" class="sidebar-tab"/>
                </ui:VisualElement>
                <ui:VisualElement class="control-panel">
                    <ui:VisualElement name="patch-controls" class="patch-controls">
                        <ui:ScrollView name="main-patch-controls" class="sidebar-tab-content patch-list-controls" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto"/>
                        <ui:ScrollView name="overlay-patch-controls" class="sidebar-tab-content patch-list-controls is-hidden" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto"/>
                        <ui:ScrollView name="effect-node-controls" class="sidebar-tab-content patch-list-controls is-hidden" mode="Vertical" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="sidebar-status">
                        <ui:Label name="capability-status" class="status-label"/>
                        <ui:Label name="diagnostic-status" class="diagnostic-label"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="bottom-bar">
            <ui:VisualElement name="tempo-controls" class="tempo-controls is-hidden">
                <ui:VisualElement class="tempo-input-row">
                    <ui:TextField name="bpm-field" class="tempo-bpm-input" is-delayed="true"/>
                    <ui:Button name="bpm-tap" text="TAP" class="tempo-tap-button"/>
                </ui:VisualElement>
                <ui:Button name="beat-alignment-button" text="ALIGN BEAT" class="tempo-alignment-button"/>
                <ui:Button name="time-easing-button" text="TIME EASE ON" class="tempo-alignment-button tempo-time-easing-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="edit-mode-highlight" class="edit-mode-highlight" picking-mode="Ignore"/>
    </ui:VisualElement>
</ui:UXML>
