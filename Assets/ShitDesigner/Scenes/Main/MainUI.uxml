<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/ShitDesigner/Scenes/Main/MainUI.uss?fileID=7433441132597879392&amp;guid=7e3b7d42d5904ebf83a22f50f92ce618&amp;type=3#MainUI"/>
    <ui:VisualElement name="main-ui" class="main-ui">
        <ui:VisualElement class="workspace">
            <ui:VisualElement class="preview-stack">
                <ui:VisualElement name="program-monitor" class="program-monitor"/>
                <ui:VisualElement class="live-fader-panel">
                    <ui:VisualElement name="parameter-controls" class="parameter-controls"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="control-panel">
                <ui:VisualElement name="patch-controls" class="patch-controls"/>
                <ui:Label name="display-selector" class="display-selector" text="OUTPUT: No external Display"/>
                <ui:VisualElement class="output-actions">
                    <ui:Button name="output-toggle" text="START OUTPUT" class="output-action"/>
                    <ui:Button name="identify-display" text="IDENTIFY" class="output-action output-action-secondary"/>
                </ui:VisualElement>
                <ui:Label name="capability-status" class="status-label"/>
                <ui:Label name="diagnostic-status" class="diagnostic-label"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="output-confirm-overlay" class="confirmation-overlay is-hidden">
            <ui:VisualElement class="confirmation-dialog">
                <ui:Label name="output-confirm-title" text="START LIVE OUTPUT?" class="confirmation-title"/>
                <ui:VisualElement class="confirmation-rule"/>
                <ui:Label name="output-confirm-message" text="Send Program output to connected external Displays." class="confirmation-message"/>
                <ui:Label name="output-confirm-display-selector" class="display-selector" text="OUTPUT DISPLAYS: No external Display"/>
                <ui:VisualElement class="confirmation-actions">
                    <ui:Button name="output-confirm-cancel" text="CANCEL" class="confirmation-button confirmation-cancel"/>
                    <ui:Button name="output-confirm-accept" text="START" class="confirmation-button confirmation-accept"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
