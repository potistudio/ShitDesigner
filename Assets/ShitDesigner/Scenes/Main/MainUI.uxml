<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/ShitDesigner/Scenes/Main/MainUI.uss?fileID=7433441132597879392&amp;guid=7e3b7d42d5904ebf83a22f50f92ce618&amp;type=3#MainUI"/>
    <ui:VisualElement name="main-ui" class="main-ui">
        <ui:VisualElement class="workspace">
            <ui:VisualElement class="preview-stack">
                <ui:VisualElement class="output-previews">
                    <ui:VisualElement name="program-monitor" class="output-preview output-preview-1">
                        <ui:Label text="Output 1" class="output-preview-label"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="output-2-column">
                        <ui:VisualElement name="output-2-preview" class="output-preview output-preview-2">
                            <ui:Label text="Output 2" class="output-preview-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="patch-slot-controls" class="patch-slot-controls">
                            <ui:Button name="patch-slot-0" text="1" class="patch-slot-button"/>
                            <ui:Button name="patch-slot-1" text="2" class="patch-slot-button"/>
                            <ui:Button name="patch-slot-2" text="3" class="patch-slot-button"/>
                            <ui:Button name="patch-slot-3" text="4" class="patch-slot-button"/>
                            <ui:Button name="patch-slot-4" text="5" class="patch-slot-button"/>
                            <ui:Button name="patch-slot-5" text="6" class="patch-slot-button"/>
                            <ui:Button name="patch-slot-6" text="7" class="patch-slot-button"/>
                            <ui:Button name="patch-slot-7" text="8" class="patch-slot-button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="patch-dock">
                    <ui:VisualElement name="patch-controls" class="patch-controls">
                        <ui:VisualElement name="patch-role-labels" class="patch-role-labels">
                            <ui:Label text="MAIN" class="patch-role-label"/>
                            <ui:Label text="OVERLAY" class="patch-role-label"/>
                        </ui:VisualElement>
                        <ui:VisualElement class="patch-scroll-rows">
                            <ui:ScrollView name="main-patch-controls" class="patch-row-controls" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden"/>
                            <ui:ScrollView name="overlay-patch-controls" class="patch-row-controls" mode="Horizontal" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="sequencer-controls" class="sequencer-controls">
                    <ui:VisualElement name="overlay-sequencer" class="sequencer"/>
                    <ui:VisualElement name="effect-sequencer" class="sequencer"/>
                    <ui:VisualElement name="compositing-mode-sequencer" class="sequencer"/>
                </ui:VisualElement>
                <ui:VisualElement class="live-fader-panel">
                    <ui:VisualElement name="parameter-controls" class="parameter-controls"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="inspector-column">
                <ui:VisualElement name="top-bar" class="top-bar">
                    <ui:VisualElement class="output-actions">
                        <ui:Button name="output-toggle" text="START OUTPUT" class="output-action"/>
                        <ui:Button name="identify-display" text="IDENTIFY" class="output-action output-action-secondary"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="control-panel">
                    <ui:VisualElement name="tempo-controls" class="tempo-controls is-hidden">
                        <ui:VisualElement class="tempo-input-row">
                            <ui:TextField name="bpm-field" class="tempo-bpm-input" is-delayed="true"/>
                            <ui:Button name="bpm-tap" text="TAP" class="tempo-tap-button"/>
                        </ui:VisualElement>
                        <ui:Button name="beat-alignment-button" text="ALIGN BEAT" class="tempo-alignment-button"/>
                    </ui:VisualElement>
                    <ui:Label name="capability-status" class="status-label"/>
                    <ui:Label name="diagnostic-status" class="diagnostic-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="output-confirm-overlay" class="confirmation-overlay is-hidden">
            <ui:VisualElement class="confirmation-dialog">
                <ui:Label name="output-confirm-title" text="START LIVE OUTPUT?" class="confirmation-title"/>
                <ui:VisualElement class="confirmation-rule"/>
                <ui:Label name="output-confirm-message" text="Send Program output to connected external Displays." class="confirmation-message"/>
                <ui:Label name="output-confirm-display-selector" class="display-selector" text="OUTPUT DISPLAYS: No external Display"/>
                <ui:VisualElement class="confirmation-actions">
                    <ui:Button name="output-confirm-cancel" text="CANCEL" class="confirmation-button confirmation-cancel"/>
                    <ui:Button name="output-confirm-accept" text="START" class="confirmation-button confirmation-accept"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
