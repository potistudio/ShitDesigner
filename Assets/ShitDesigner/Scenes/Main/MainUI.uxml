                    <ui:Button name="instant-effect-cue-8" text="I" tooltip="Hold for Piano FX 8" class="instant-effect-cue-button"/>
                    <ui:Button name="instant-effect-cue-9" text="O" tooltip="Hold for Piano FX 9" class="instant-effect-cue-button"/>
