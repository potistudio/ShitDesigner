.overlay-decoration {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    picking-mode: ignore;
}

.corner {
    position: absolute;
    width: 112px;
    height: 112px;
    picking-mode: ignore;
}

.corner-top-left {
    left: 32px;
    top: 32px;
}

.corner-top-right {
    right: 32px;
    top: 32px;
}

.corner-bottom-left {
    left: 32px;
    bottom: 32px;
}

.corner-bottom-right {
    right: 32px;
    bottom: 32px;
}

.corner-stroke,
.corner-inset,
.corner-node {
    position: absolute;
}

.corner-stroke,
.corner-inset,
.strip-segment {
    background-color: rgba(232, 236, 242, 0.74);
}

.corner-stroke-horizontal {
    left: 0;
    top: 0;
    width: 112px;
    height: 1px;
}

.corner-stroke-vertical {
    left: 0;
    top: 0;
    width: 1px;
    height: 112px;
}

.corner-inset {
    background-color: rgba(88, 166, 255, 0.62);
}

.corner-inset-horizontal {
    left: 12px;
    top: 12px;
    width: 44px;
    height: 1px;
}

.corner-inset-vertical {
    left: 12px;
    top: 12px;
    width: 1px;
    height: 44px;
}

.corner-node {
    position: absolute;
    left: -2px;
    top: -2px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: rgb(232, 236, 242);
}

.corner-top-right .corner-stroke-horizontal,
.corner-top-right .corner-stroke-vertical {
    left: auto;
    right: 0;
}

.corner-top-right .corner-inset-horizontal,
.corner-top-right .corner-inset-vertical {
    left: auto;
    right: 12px;
}

.corner-top-right .corner-node {
    left: auto;
    right: -2px;
}

.corner-bottom-left .corner-stroke-horizontal,
.corner-bottom-left .corner-stroke-vertical {
    top: auto;
    bottom: 0;
}

.corner-bottom-left .corner-inset-horizontal,
.corner-bottom-left .corner-inset-vertical {
    top: auto;
    bottom: 12px;
}

.corner-bottom-left .corner-node {
    top: auto;
    bottom: -2px;
}

.corner-bottom-right .corner-stroke-horizontal,
.corner-bottom-right .corner-stroke-vertical {
    left: auto;
    top: auto;
    right: 0;
    bottom: 0;
}

.corner-bottom-right .corner-inset-horizontal,
.corner-bottom-right .corner-inset-vertical {
    left: auto;
    top: auto;
    right: 12px;
    bottom: 12px;
}

.corner-bottom-right .corner-node {
    left: auto;
    top: auto;
    right: -2px;
    bottom: -2px;
}

.ornament-strip {
    position: absolute;
    opacity: 0.62;
    picking-mode: ignore;
}

.strip-segment {
    flex-shrink: 0;
}

.ornament-strip-top,
.ornament-strip-bottom {
    left: 50%;
    width: 176px;
    height: 5px;
    margin-left: -88px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.ornament-strip-top {
    top: 32px;
}

.ornament-strip-bottom {
    bottom: 32px;
}

.ornament-strip-left,
.ornament-strip-right {
    top: 50%;
    width: 5px;
    height: 176px;
    margin-top: -88px;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
}

.ornament-strip-left {
    left: 32px;
}

.ornament-strip-right {
    right: 32px;
}

.strip-short {
    width: 12px;
    height: 1px;
}

.strip-medium {
    width: 28px;
    height: 1px;
}

.strip-long {
    width: 72px;
    height: 1px;
}

.ornament-strip-left .strip-short,
.ornament-strip-left .strip-medium,
.ornament-strip-left .strip-long,
.ornament-strip-right .strip-short,
.ornament-strip-right .strip-medium,
.ornament-strip-right .strip-long {
    width: 1px;
    height: 12px;
}

.ornament-strip-left .strip-medium,
.ornament-strip-right .strip-medium {
    height: 28px;
}

.ornament-strip-left .strip-long,
.ornament-strip-right .strip-long {
    height: 72px;
}

.strip-accent {
    background-color: rgba(200, 121, 232, 0.82);
}
