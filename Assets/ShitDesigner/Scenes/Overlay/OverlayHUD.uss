.overlay-hud {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(232, 236, 242);
    -unity-font-definition: resource("NotoSans");
    picking-mode: ignore;
}

.hud-card {
    position: absolute;
    width: 192px;
    height: 64px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(13, 15, 18, 0.84);
    border-width: 1px;
    border-color: rgba(88, 166, 255, 0.8);
    picking-mode: ignore;
}

.hud-top-left {
    left: 24px;
    top: 24px;
}

.hud-top-right {
    right: 24px;
    top: 24px;
    align-items: flex-end;
}

.hud-bottom-left {
    left: 24px;
    bottom: 24px;
}

.hud-bottom-right {
    right: 24px;
    bottom: 24px;
    align-items: flex-end;
}

.hud-title {
    color: rgb(255, 255, 255);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.hud-label {
    color: rgb(157, 167, 180);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}

.hud-value {
    color: rgb(232, 236, 242);
    font-size: 15px;
    -unity-font-style: bold;
}

.hud-mono {
    -unity-font-definition: resource("NotoSansMono");
}

.hud-status-row,
.hud-output-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.hud-status-dot {
    width: 7px;
    height: 7px;
    margin-right: 7px;
    background-color: rgb(76, 195, 138);
}

.hud-status {
    color: rgb(76, 195, 138);
    font-size: 9px;
    letter-spacing: 0.8px;
    -unity-font-style: bold;
}
