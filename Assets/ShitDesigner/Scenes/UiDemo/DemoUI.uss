.demo-root {
    flex-grow: 1;
    min-width: 1280px;
    min-height: 720px;
    flex-direction: column;
    background-color: rgb(13, 15, 18);
    color: rgb(232, 236, 242);
    -unity-font-definition: resource("NotoSans");
    font-size: 12px;
}

.demo-root Button { -unity-font-definition: resource("NotoSans"); }
.demo-mono { -unity-font-definition: resource("NotoSansMono"); }
.demo-spacer { flex-grow: 1; }

.demo-topbar {
    height: 40px;
    min-height: 40px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(21, 24, 29);
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 55, 65);
}

.demo-button {
    height: 32px;
    min-width: 80px;
    margin-left: 8px;
    padding-left: 12px;
    padding-right: 12px;
    color: rgb(232, 236, 242);
    background-color: rgb(29, 34, 41);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    font-size: 9px;
    letter-spacing: .6px;
    -unity-font-style: bold;
}

.demo-button:hover { color: white; background-color: rgb(36, 43, 52); border-color: rgb(88, 166, 255); }

.demo-live-button {
    color: white;
    background-color: rgb(47, 111, 179);
    border-color: rgb(88, 166, 255);
}

.demo-live-button.is-paused {
    color: rgb(232, 236, 242);
    background-color: rgb(29, 34, 41);
    border-color: rgb(48, 55, 65);
}

.demo-content {
    flex-grow: 1;
    min-height: 0;
    padding: 8px;
}

.demo-upper-row {
    height: 46%;
    min-height: 250px;
    flex-direction: row;
}

.demo-panel {
    background-color: rgb(21, 24, 29);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.demo-preview-panel, .demo-grid-panel { width: 50%; }
.demo-preview-panel { margin-right: 8px; }

.demo-panel-header {
    height: 32px;
    min-height: 32px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 55, 65);
}

.demo-panel-title {
    color: rgb(232, 236, 242);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.demo-panel-meta {
    margin-left: auto;
    color: rgb(157, 167, 180);
    font-size: 9px;
    letter-spacing: .7px;
}

.demo-live-label {
    margin-left: auto;
    color: rgb(88, 166, 255);
    font-size: 9px;
    letter-spacing: .7px;
    -unity-font-style: bold;
}

.demo-live-label.is-paused { color: rgb(232, 180, 76); }

.demo-preview {
    flex-grow: 1;
    margin: 8px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(9, 10, 12);
}

.preview-paused { opacity: .42; }

.demo-grid { flex-grow: 1; padding: 8px; }
.demo-grid-row { flex-grow: 1; flex-direction: row; margin-bottom: 8px; }
.demo-grid-row:last-child { margin-bottom: 0; }

.demo-grid-cell {
    flex-grow: 1;
    width: 33.33%;
    margin-right: 8px;
    padding: 8px;
    justify-content: flex-end;
    background-color: rgb(29, 34, 41);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
}

.demo-grid-cell:last-child { margin-right: 0; }

.demo-grid-cell:hover { border-color: rgb(88, 166, 255); }
.demo-cell-active { background-color: rgb(31, 47, 68); border-color: rgb(88, 166, 255); }
.demo-cell-output { background-color: rgb(29, 42, 58); border-color: rgb(88, 166, 255); }

.demo-cell-number {
    position: absolute;
    right: 8px;
    top: 8px;
    color: rgb(157, 167, 180);
    font-size: 9px;
}

.demo-cell-label {
    color: rgb(232, 236, 242);
    font-size: 9px;
    letter-spacing: .8px;
    -unity-font-style: bold;
}

.grid-disabled .demo-grid-cell { border-color: transparent; }

.demo-fader-panel {
    flex-grow: 1;
    min-height: 250px;
    margin-top: 8px;
}

.demo-fader-header { flex-shrink: 0; }

.demo-fader-bank {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    justify-content: space-around;
    padding: 16px;
}

.demo-fader-channel {
    flex-grow: 1;
    min-width: 100px;
    max-width: 180px;
    align-items: center;
}

.demo-fader-value {
    height: 28px;
    min-width: 56px;
    -unity-text-align: middle-center;
    color: rgb(232, 236, 242);
    background-color: rgb(13, 15, 18);
    border-width: 1px;
    border-color: rgb(48, 55, 65);
    -unity-font-definition: resource("NotoSansMono");
    font-size: 10px;
}

.demo-fader {
    flex-grow: 1;
    min-height: 100px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.demo-fader .unity-base-slider__tracker {
    width: 4px;
    background-color: rgb(48, 55, 65);
    border-width: 0;
}

.demo-fader .unity-base-slider__dragger {
    width: 28px;
    height: 12px;
    margin-left: -11px;
    background-color: rgb(88, 166, 255);
    border-width: 1px;
    border-color: rgb(180, 215, 255);
}

.demo-fader-accent .unity-base-slider__dragger {
    background-color: rgb(88, 166, 255);
    border-color: rgb(180, 215, 255);
}

.demo-fader-label {
    color: rgb(157, 167, 180);
    font-size: 9px;
    letter-spacing: .8px;
    -unity-font-style: bold;
}

.demo-statusbar {
    height: 24px;
    min-height: 24px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(21, 24, 29);
    border-top-width: 1px;
    border-top-color: rgb(48, 55, 65);
}

.demo-health-dot {
    width: 8px;
    height: 8px;
    margin-right: 8px;
    background-color: rgb(76, 195, 138);
}

.demo-status-strong, .demo-status-copy { color: rgb(232, 236, 242); font-size: 9px; }
.demo-status-strong { -unity-font-style: bold; }
.demo-status-copy { margin-left: 8px; color: rgb(157, 167, 180); }

.demo-divider {
    width: 1px;
    height: 12px;
    margin-left: 8px;
    margin-right: 8px;
    background-color: rgb(48, 55, 65);
}

*:focus { border-color: rgb(88, 166, 255); }
