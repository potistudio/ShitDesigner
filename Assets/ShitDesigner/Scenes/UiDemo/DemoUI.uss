.demo-root {
    flex-grow: 1;
    min-width: 1280px;
    min-height: 720px;
    flex-direction: column;
    background-color: rgb(9, 11, 15);
    color: rgb(228, 233, 242);
    -unity-font-definition: resource("NotoSans");
    font-size: 12px;
}

.demo-root Button { -unity-font-definition: resource("NotoSans"); }
.demo-mono { -unity-font-definition: resource("NotoSansMono"); }
.demo-spacer { flex-grow: 1; }

.demo-topbar {
    height: 52px;
    min-height: 52px;
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    background-color: rgb(17, 20, 27);
    border-bottom-width: 1px;
    border-bottom-color: rgb(40, 46, 58);
}

.demo-brand-mark {
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    color: white;
    background-color: rgb(91, 104, 255);
    border-radius: 7px;
    -unity-font-style: bold;
}

.demo-brand {
    margin-left: 10px;
    color: rgb(238, 241, 247);
    letter-spacing: 1.4px;
    -unity-font-style: bold;
}

.demo-project {
    margin-left: 24px;
    padding-left: 24px;
    color: rgb(129, 139, 158);
    border-left-width: 1px;
    border-left-color: rgb(47, 54, 67);
    font-size: 10px;
    letter-spacing: .8px;
}

.demo-button {
    height: 29px;
    min-width: 74px;
    margin-left: 7px;
    padding-left: 11px;
    padding-right: 11px;
    color: rgb(180, 189, 205);
    background-color: rgb(28, 33, 43);
    border-width: 1px;
    border-color: rgb(51, 59, 73);
    border-radius: 4px;
    font-size: 9px;
    letter-spacing: .6px;
    -unity-font-style: bold;
}

.demo-button:hover { color: white; border-color: rgb(101, 113, 255); }

.demo-live-button {
    color: white;
    background-color: rgb(217, 56, 87);
    border-color: rgb(242, 78, 110);
}

.demo-live-button.is-paused {
    color: rgb(190, 198, 211);
    background-color: rgb(38, 44, 56);
    border-color: rgb(62, 71, 87);
}

.demo-content {
    flex-grow: 1;
    min-height: 0;
    padding: 8px;
}

.demo-upper-row {
    height: 46%;
    min-height: 250px;
    flex-direction: row;
}

.demo-panel {
    background-color: rgb(16, 19, 25);
    border-width: 1px;
    border-color: rgb(39, 45, 57);
    border-radius: 5px;
}

.demo-preview-panel, .demo-grid-panel { width: 50%; }
.demo-preview-panel { margin-right: 4px; }
.demo-grid-panel { margin-left: 4px; }

.demo-panel-header {
    height: 34px;
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    padding-left: 11px;
    padding-right: 11px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(39, 45, 57);
}

.demo-panel-title {
    color: rgb(220, 225, 235);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

.demo-panel-meta {
    margin-left: auto;
    color: rgb(105, 116, 136);
    font-size: 9px;
    letter-spacing: .7px;
}

.demo-live-label {
    margin-left: auto;
    color: rgb(241, 75, 107);
    font-size: 9px;
    letter-spacing: .7px;
    -unity-font-style: bold;
}

.demo-live-label.is-paused { color: rgb(232, 181, 77); }

.demo-preview {
    flex-grow: 1;
    margin: 8px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(15, 15, 37);
    border-radius: 3px;
}

.demo-preview-orb { position: absolute; border-radius: 50%; }

.demo-preview-orb-left {
    width: 220px;
    height: 220px;
    left: 6%;
    bottom: -100px;
    background-color: rgb(63, 48, 143);
    border-width: 34px;
    border-color: rgb(225, 69, 147);
}

.demo-preview-orb-right {
    width: 180px;
    height: 180px;
    right: 5%;
    top: -74px;
    background-color: rgb(38, 177, 199);
    border-width: 28px;
    border-color: rgb(63, 87, 216);
}

.demo-preview-frame {
    position: absolute;
    left: 16px;
    right: 16px;
    top: 16px;
    bottom: 16px;
    border-width: 1px;
    border-color: rgba(235, 239, 248, .3);
}

.demo-preview-title {
    color: white;
    font-size: 21px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.demo-preview-subtitle {
    margin-top: 5px;
    color: rgb(203, 211, 226);
    font-size: 8px;
    letter-spacing: 1.5px;
}

.preview-paused { opacity: .42; }

.demo-grid { flex-grow: 1; padding: 8px; }
.demo-grid-row { flex-grow: 1; flex-direction: row; }

.demo-grid-cell {
    flex-grow: 1;
    width: 33.33%;
    margin: 3px;
    padding: 9px;
    justify-content: flex-end;
    background-color: rgb(21, 25, 33);
    border-width: 1px;
    border-color: rgb(45, 52, 65);
    border-radius: 3px;
}

.demo-grid-cell:hover { border-color: rgb(101, 113, 255); }
.demo-cell-active { background-color: rgb(31, 29, 57); border-color: rgb(131, 98, 229); }
.demo-cell-output { background-color: rgb(23, 32, 51); border-color: rgb(67, 119, 211); }

.demo-cell-number {
    position: absolute;
    right: 8px;
    top: 7px;
    color: rgb(84, 94, 112);
    font-size: 9px;
}

.demo-cell-label {
    color: rgb(184, 193, 208);
    font-size: 9px;
    letter-spacing: .8px;
    -unity-font-style: bold;
}

.grid-disabled .demo-grid-cell { border-color: transparent; }

.demo-fader-panel {
    flex-grow: 1;
    min-height: 250px;
    margin-top: 8px;
}

.demo-fader-header { flex-shrink: 0; }

.demo-fader-bank {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    justify-content: space-around;
    padding: 10px 24px 12px 24px;
}

.demo-fader-channel {
    flex-grow: 1;
    min-width: 100px;
    max-width: 180px;
    align-items: center;
}

.demo-fader-value {
    height: 24px;
    min-width: 52px;
    -unity-text-align: middle-center;
    color: rgb(202, 210, 224);
    background-color: rgb(11, 14, 19);
    border-width: 1px;
    border-color: rgb(43, 50, 63);
    border-radius: 3px;
    -unity-font-definition: resource("NotoSansMono");
    font-size: 10px;
}

.demo-fader {
    flex-grow: 1;
    min-height: 100px;
    margin-top: 8px;
    margin-bottom: 8px;
}

.demo-fader .unity-base-slider__tracker {
    width: 5px;
    background-color: rgb(43, 49, 62);
    border-width: 0;
    border-radius: 3px;
}

.demo-fader .unity-base-slider__dragger {
    width: 28px;
    height: 12px;
    margin-left: -11px;
    background-color: rgb(98, 109, 255);
    border-width: 2px;
    border-color: rgb(174, 182, 255);
    border-radius: 3px;
}

.demo-fader-accent .unity-base-slider__dragger {
    background-color: rgb(226, 68, 108);
    border-color: rgb(255, 136, 163);
}

.demo-fader-label {
    color: rgb(128, 139, 158);
    font-size: 9px;
    letter-spacing: .8px;
    -unity-font-style: bold;
}

.demo-statusbar {
    height: 26px;
    min-height: 26px;
    flex-direction: row;
    align-items: center;
    padding-left: 13px;
    padding-right: 13px;
    background-color: rgb(14, 17, 23);
    border-top-width: 1px;
    border-top-color: rgb(38, 44, 56);
}

.demo-health-dot {
    width: 7px;
    height: 7px;
    margin-right: 7px;
    background-color: rgb(73, 201, 133);
    border-radius: 4px;
}

.demo-status-strong, .demo-status-copy { color: rgb(177, 187, 203); font-size: 9px; }
.demo-status-strong { -unity-font-style: bold; }
.demo-status-copy { margin-left: 9px; color: rgb(116, 127, 146); }

.demo-divider {
    width: 1px;
    height: 12px;
    margin-left: 12px;
    margin-right: 3px;
    background-color: rgb(46, 53, 66);
}

*:focus { border-color: rgb(101, 113, 255); }
